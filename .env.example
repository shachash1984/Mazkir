# Run npm run setup to generate the local encryption key and guided config.
DATA_DIR=./data
ENCRYPTION_KEY=
OPENAI_API_KEY=
MS_CLIENT_ID=
ORGANIZER_EMAIL=
# Exactly two entries. phone is international digits without +; jid is resolved by pairing.
FAMILY_MEMBERS=[{"name":"Me","phone":"972500000001","email":"me@example.com"},{"name":"Spouse","phone":"972500000002","email":"spouse@example.com"}]
# Independent Healthchecks.io ping URL (configure its email integration in their dashboard).
HEALTHCHECK_URL=
AI_MONTHLY_USD_CAP=8
# Shared voice selected after reviewing bilingual samples.
SPEECH_VOICE=nova
LOG_LEVEL=info
